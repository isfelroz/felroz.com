---
/** Fallback drawing for projects without their own: the dotted route from a hollow node to the Pêche arrival dot. Decorative. */
const dots = Array.from({ length: 7 * 7 }, (_, i) => ({ x: 16 + (i % 7) * 28, y: 16 + Math.floor(i / 7) * 28 }))
---

<svg class="default" viewBox="0 0 200 200" aria-hidden="true">
  {dots.map((d) => <circle cx={d.x} cy={d.y} r="2" fill="#3A3D43" />)}
  <path d="M44 150 C 70 150, 80 100, 110 100 S 150 56, 158 50" fill="none" stroke="#CA6678" stroke-width="3" stroke-dasharray="1 9" stroke-linecap="round"></path>
  <circle cx="44" cy="150" r="9" fill="#1F2124" stroke="#CA6678" stroke-width="4"></circle>
  <circle cx="160" cy="48" r="12" fill="#E98A77"></circle>
</svg>

<style>
  .default {
    width: 100%;
    height: 100%;
  }
</style>
