---
/** Nine trades (nodes on a dotted ring) around one tool (the helicopter). Nodes turn Corail and the rotor spins on card hover. */
import Helicopter from '@components/home/Helicopter.astro'

const { label } = Astro.props
const C = 260
const R = 197.6
const nodes = Array.from({ length: 9 }, (_, i) => {
  const a = (i * 2 * Math.PI) / 9 - Math.PI / 2
  return { x: +(C + R * Math.cos(a)).toFixed(1), y: +(C + R * Math.sin(a)).toFixed(1) }
})
---

<svg class="crm" viewBox="0 0 520 520" role="img">
  <title>{label}</title>
  <circle cx={C} cy={C} r={R} fill="none" stroke="#CA6678" stroke-width="4" stroke-dasharray="1 16" stroke-linecap="round"></circle>
  <Helicopter ring={false} x="92" y="115.4" width="336" height="336" />
  {nodes.map((n) => <circle class="node" cx={n.x} cy={n.y} r="15" stroke-width="4" />)}
</svg>

<style>
  .node {
    fill: var(--color-carbone-deep);
    stroke: var(--color-label-dark);
  }
  @media (prefers-reduced-motion: no-preference) {
    .node {
      transition:
        stroke 0.25s,
        fill 0.25s;
    }
  }
  :global(.proj:hover) .node {
    stroke: var(--color-corail);
  }
  .node:hover {
    fill: var(--color-corail);
  }
</style>
