---
/** "Today" card: route motif on top (never behind text), copy below. */
const { title, text, place } = Astro.props
---

<div class="flex h-full flex-col gap-4">
  <svg
    class="min-h-16 w-full grow"
    viewBox="0 0 420 120"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    <path
      d="M14 104 C 80 96, 110 64, 170 60 S 260 30, 330 26 S 384 18, 404 12"
      fill="none"
      stroke="#CA6678"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray="1 11"></path>
    <circle cx="14" cy="104" r="6" fill="#26282C" stroke="#9E4B88" stroke-width="3"></circle>
    <circle cx="170" cy="60" r="6" fill="#26282C" stroke="#CA6678" stroke-width="3"></circle>
    <circle cx="330" cy="26" r="6" fill="#26282C" stroke="#CA6678" stroke-width="3"></circle>
    <circle cx="404" cy="12" r="8" fill="#E98A77"></circle>
  </svg>
  <div class="flex flex-col gap-2">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h2 class="text-2xl font-bold tracking-[-0.02em]">{title}</h2>
      <p class="label-mono text-label-dark">{place}</p>
    </div>
    <p class="max-w-[60ch] text-ink-soft text-pretty">{text}</p>
  </div>
</div>
