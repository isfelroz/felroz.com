---
import { Image } from 'astro:assets'
import Icon from '@components/react/Icon.jsx'
import avatarImage from '@assets/me.png'

const { title, description, avatar } = Astro.props
---

<div class="h-full flex flex-col justify-between gap-6 md:gap-0">
  <div class="flex flex-col-reverse gap-5 items-center md:flex-row md:justify-between md:items-end">
    <h1 class="font-bold text-4xl">{title}</h1>
    <Image
      src={avatarImage}
      width={avatar?.width}
      height={avatar?.height}
      alt={avatar?.alt ?? ''}
      loading="lazy"
    />
  </div>
  <div class="flex flex-col md:flex-row md:justify-between items-end gap-6 md:gap-0">
    <p class="text-gray text-xl items-end text-center md:text-left md:w-[70%]">
      {description}
    </p>
    <div class="h-fit icon-svg">
      <Icon type="arrow" />
    </div>
  </div>
</div>
