---
import Icon from '@components/react/Icon.jsx'

const { title, text, size = 'small' } = Astro.props
---

<div class="flex h-full w-full flex-col justify-end gap-3">
  <div class="flex grow items-center justify-center"><slot /></div>
  <div class="flex items-end justify-between gap-6">
    <h2
      class:list={[
        'font-bold tracking-[-0.02em] text-balance',
        size === 'large' ? 'text-4xl lg:text-5xl' : 'text-2xl',
      ]}
    >
      {title}
    </h2>
    <div class="h-fit shrink-0">
      <Icon type="arrow" />
    </div>
  </div>
  {text && <p class="max-w-[60ch] text-ink-soft text-pretty">{text}</p>}
</div>
