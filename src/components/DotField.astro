---
// Site-wide dot field. Static unless the pointer moves; never animates on its own.
---

<canvas
  data-dot-field
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-0 h-dvh w-screen"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dot-field]')
  const ctx = canvas?.getContext('2d')

  if (canvas && ctx) {
    const GAP = 22
    const R = 150
    const base = [58, 61, 67]
    const hot = [202, 102, 120]
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    let w = 0
    let h = 0
    let px = -999
    let py = -999
    let raf = 0

    const draw = () => {
      raf = 0
      ctx.clearRect(0, 0, w, h)
      const oy = GAP / 2 - (scrollY % GAP)
      for (let y = oy; y < h + GAP; y += GAP) {
        for (let x = GAP / 2; x < w; x += GAP) {
          const d = Math.hypot(x - px, y - py)
          const t = d < R ? (1 - d / R) ** 2 : 0
          const r = base[0] + ((hot[0] - base[0]) * t | 0)
          const g = base[1] + ((hot[1] - base[1]) * t | 0)
          const b = base[2] + ((hot[2] - base[2]) * t | 0)
          ctx.fillStyle = `rgb(${r},${g},${b})`
          ctx.beginPath()
          ctx.arc(x, y, 1.3 + t * 1.4, 0, Math.PI * 2)
          ctx.fill()
        }
      }
    }

    const queue = () => {
      if (!raf) raf = requestAnimationFrame(draw)
    }

    const size = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2)
      w = innerWidth
      h = innerHeight
      canvas.width = w * dpr
      canvas.height = h * dpr
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      queue()
    }

    addEventListener('resize', size)
    addEventListener('scroll', queue, { passive: true })
    if (!reduce) {
      addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType === 'touch') return
          px = e.clientX
          py = e.clientY
          queue()
        },
        { passive: true },
      )
    }
    size()
  }
</script>
