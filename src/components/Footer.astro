---
import Container from '@components/Container.astro'
import NavLinks from '@components/NavLinks.astro'
import Icon from '@components/react/Icon.jsx'
import Logo from '@components/react/Logo.jsx'

const { menu, socials } = Astro.props
---

<Container>
  <div class="grid gap-16 py-5">
    <div class="flex lg:flex-row flex-col items-center lg:items-end gap-16 w-fit m-auto">
      <Logo client:visible width={150} />
      <NavLinks links={menu} classes="gap-10 lg:gap-16" />
    </div>
    {
      socials?.length > 0 && (
        <div class="flex gap-12 w-fit m-auto">
          {socials.map((social) => (
            <a href={social.href} aria-label={social.type}>
              <Icon type={social.type} size="30px" hover={true} />
            </a>
          ))}
        </div>
      )
    }
    <div class="flex flex-col items-center lg:flex-row w-fit m-auto gap-10">
      <div>© 2022 falroz</div>
      <div>
        <span class="mr-2 font-bold text-transparent bg-clip-text bg-linear-to-r from-[#9E4B88] via-[#CA6678] to-[#E98A77]">
          Built by
        </span>
        <a href="#">Felipe Alarcon</a>
      </div>
      <div>
        <a
          href="https://github.com/falroz/falroz"
          rel="noopener"
          target="_blank"
          class="flex gap-2 items-center"
        >
          <Icon type="github" size="16px" /> Code Source
        </a>
      </div>
    </div>
  </div>
</Container>
