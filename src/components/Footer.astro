---
import Container from '@components/Container.astro'
import NavLinks from '@components/NavLinks.astro'
import Lockup from '@components/brand/Lockup.astro'
import Icon from '@components/react/Icon.jsx'
import globalData from '@data/global.json'
import { localizePath, useTranslations } from '../i18n/index.js'

const { locale } = Astro.props
const t = useTranslations(locale)
const links = ['projects', 'resume', 'about', 'contact'].map((key) => ({
  label: t.nav[key],
  href: localizePath(key, locale),
}))
const year = new Date().getFullYear()
---

<footer class="relative z-[1] pt-10 pb-8">
  <Container>
    <div class="grid gap-12">
      <div class="m-auto flex w-fit flex-col items-center gap-10 lg:flex-row lg:gap-16">
        <Lockup href={localizePath('home', locale)} size={48} label={`felroz — ${t.nav.home}`} />
        <nav aria-label={t.nav.main}>
          <NavLinks links={links} classes="flex-wrap justify-center gap-x-10 gap-y-4 lg:gap-x-16" />
        </nav>
      </div>
      <ul class="m-auto flex w-fit gap-10">
        {
          globalData.socials.map((social) => (
            <li>
              <a
                href={social.href}
                rel="me noopener"
                target="_blank"
                aria-label={t.home.socialLabel.replace('{name}', social.name)}
              >
                <Icon type={social.type} size="28px" hover={true} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="m-auto flex w-fit flex-col items-center gap-4 text-sm text-ink-soft lg:flex-row lg:gap-10">
        <p>© {year} felroz</p>
        <p>{t.footer.credits}</p>
        <a
          href={globalData.sourceCode}
          rel="noopener"
          target="_blank"
          class="flex items-center gap-2 transition-colors hover:text-white"
        >
          <Icon type="github" size="16px" />
          {t.footer.source}
        </a>
      </div>
    </div>
  </Container>
</footer>
