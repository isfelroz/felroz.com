---
/**
 * felroz symbol: gradient f (no crossbar), hollow node, arrival dot.
 * Spec: DESIGN.md · Components · Symbol. Below 24px use FaviconF instead.
 */
interface Props {
  size?: number
  shape?: 'square' | 'circle'
  label?: string
  class?: string
}

const { size = 40, shape = 'square', label, class: className } = Astro.props
const gradientId = `felroz-g-${Math.random().toString(36).slice(2, 8)}`
---

<svg
  class:list={['felroz-symbol', className]}
  width={size}
  height={size}
  viewBox="0 0 120 120"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#9E4B88"></stop>
      <stop offset="1" stop-color="#E98A77"></stop>
    </linearGradient>
  </defs>
  {
    shape === 'circle' ? (
      <circle cx="60" cy="60" r="60" fill="#26282C" />
    ) : (
      <rect width="120" height="120" rx="28" fill="#26282C" />
    )
  }
  <path
    d="M40 98 V50 Q40 28 62 28 H66"
    fill="none"
    stroke={`url(#${gradientId})`}
    stroke-width="14"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle class="felroz-node" cx="76" cy="52" r="6" fill="#26282C" stroke="#CA6678" stroke-width="4"></circle>
  <circle class="felroz-dot" cx="96" cy="36" r="9" fill="#E98A77"></circle>
</svg>

<style>
  .felroz-node,
  .felroz-dot {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(a:hover) > .felroz-symbol .felroz-node,
  :global(a:focus-visible) > .felroz-symbol .felroz-node {
    transform: translate(2px, -2px);
  }
  :global(a:hover) > .felroz-symbol .felroz-dot,
  :global(a:focus-visible) > .felroz-symbol .felroz-dot {
    transform: translate(4px, -4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .felroz-node,
    .felroz-dot {
      transition: none;
    }
  }
</style>
