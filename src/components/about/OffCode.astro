---
/**
 * « Hors du code » (spec · À propos 4): one shelf, three drawn objects on Deep panels.
 * Hover micro-interactions: the camera lens opens, the street's windows light up, the pizza (the home's
 * geometry, see home/MeCard.astro) turns. Unlinked, so no Split Card hover. Static under reduced motion.
 */
interface Props {
  title: string
  items: string[]
}

const { title, items } = Astro.props
const [photo, street, pizza] = items
---

<section id="offcode" class="about-sec" aria-labelledby="offcode-title">
  <h2 id="offcode-title" class="about-h2">{title}</h2>
  <div class="rounded-3xl bg-carbone p-6 shadow-card">
    <ul class="shelf">
      <li class="offcode offcode-cam">
        <span class="art">
          <svg viewBox="0 0 160 120" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path
              class="fill-carbone-deep stroke-ink-soft"
              d="M22 40 h26 l8 -12 h40 l8 12 h34 a10 10 0 0 1 10 10 v50 a10 10 0 0 1 -10 10 h-116 a10 10 0 0 1 -10 -10 v-50 a10 10 0 0 1 10 -10z"
              stroke-width="3"></path>
            <path class="stroke-label-dark" d="M12 56 h24 M12 84 h24" stroke-width="3"></path>
            <rect class="fill-dot" x="118" y="48" width="18" height="8" rx="4"></rect>
            <circle class="stroke-ink-soft" cx="80" cy="72" r="28" stroke-width="3"></circle>
            <circle class="stroke-corail" cx="80" cy="72" r="19" stroke-width="3" stroke-dasharray="1 7"></circle>
            <circle class="lens fill-peche" cx="80" cy="72" r="9"></circle>
            <circle class="fill-craie" cx="76" cy="68" r="2.5" opacity=".8"></circle>
          </svg>
        </span>
        <p class="name">{photo}</p>
      </li>
      <li class="offcode offcode-street">
        <span class="art">
          <svg viewBox="0 0 160 120" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path class="stroke-label-dark" d="M8 104 H152" stroke-width="3"></path>
            <path
              class="fill-carbone-deep stroke-ink-soft"
              d="M16 104 V58 h30 V104 M46 104 V30 h38 V104 M84 104 V50 h30 V104 M114 104 V70 h30 V104"
              stroke-width="3"></path>
            <g class="win">
              <rect x="54" y="40" width="8" height="10" rx="2"></rect>
              <rect x="68" y="40" width="8" height="10" rx="2"></rect>
              <rect x="54" y="58" width="8" height="10" rx="2"></rect>
              <rect x="68" y="58" width="8" height="10" rx="2"></rect>
              <rect x="24" y="68" width="8" height="10" rx="2"></rect>
              <rect x="92" y="60" width="8" height="10" rx="2"></rect>
              <rect x="122" y="80" width="8" height="10" rx="2"></rect>
            </g>
            <path class="stroke-corail" d="M90 92 c6 -10 14 -10 18 -2 s10 6 16 -4" stroke-width="3.5"></path>
            <path class="stroke-label-dark" d="M150 104 V40 q0 -8 -8 -8 h-6" stroke-width="3"></path>
            <circle class="fill-peche" cx="134" cy="34" r="5"></circle>
          </svg>
        </span>
        <p class="name">{street}</p>
      </li>
      <li class="offcode offcode-pizza">
        <span class="art">
          <svg class="pizza" viewBox="0 0 100 100" aria-hidden="true">
            <circle class="fill-peche" cx="50" cy="50" r="46"></circle>
            <circle class="fill-craie" cx="50" cy="50" r="38" fill-opacity=".85"></circle>
            <g class="stroke-peche" stroke-width="2.5" opacity=".7">
              <line x1="50" y1="12" x2="50" y2="88"></line>
              <line x1="12" y1="50" x2="88" y2="50"></line>
              <line x1="23" y1="23" x2="77" y2="77"></line>
              <line x1="77" y1="23" x2="23" y2="77"></line>
            </g>
            <g class="fill-corail">
              <circle cx="38" cy="30" r="7"></circle>
              <circle cx="66" cy="36" r="7"></circle>
              <circle cx="32" cy="60" r="7"></circle>
              <circle cx="60" cy="66" r="7"></circle>
              <circle cx="50" cy="48" r="5"></circle>
            </g>
            <g class="fill-prune">
              <circle cx="70" cy="58" r="2.5"></circle>
              <circle cx="44" cy="72" r="2.5"></circle>
              <circle cx="28" cy="44" r="2.5"></circle>
            </g>
          </svg>
        </span>
        <p class="name">{pizza}</p>
      </li>
    </ul>
  </div>
</section>

<style>
  .shelf {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .offcode {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  .art {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 20px;
    border-radius: 18px;
    background-color: var(--color-carbone-deep);
    background-image: radial-gradient(color-mix(in srgb, var(--color-dot) 70%, transparent) 1.2px, transparent 1.6px);
    background-size: 14px 14px;
  }
  .art svg {
    width: 72%;
    height: auto;
    overflow: visible;
  }
  .art .pizza {
    width: 50%;
  }
  .name {
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lens {
    transition: r 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .offcode-cam:hover .lens {
    r: 13;
  }
  .win rect {
    fill: var(--color-dot);
    transition: fill 0.3s;
  }
  .offcode-street:hover .win rect {
    fill: var(--color-corail);
  }
  .offcode-street:hover .win rect:nth-child(odd) {
    fill: var(--color-dot);
  }
  .pizza {
    transition: rotate 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .offcode-pizza:hover .pizza {
    rotate: 200deg;
  }

  @media (max-width: 640px) {
    .shelf {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .offcode {
      grid-template-columns: 120px minmax(0, 1fr);
      align-items: center;
    }
    .art {
      aspect-ratio: 1;
      padding: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .offcode .lens,
    .offcode .win rect,
    .offcode .pizza {
      transition: none;
    }
  }
</style>
