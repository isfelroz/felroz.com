---
/**
 * Bento card. Linked cards get the Split Card hover (DESIGN.md · Elevation & Depth).
 * `accent` is the underlayer color class (bg-corail by default).
 */
const { href, accent = 'bg-corail', label } = Astro.props
const face = 'h-full w-full rounded-3xl bg-carbone p-7 max-[640px]:p-6 shadow-card'
---

{
  href ? (
    <a href={href} aria-label={label} class="group block h-full rounded-3xl">
      <div class="relative isolate h-full">
        <div data-card-face class:list={[face, 'transition-all group-hover:translate-x-2 group-hover:-translate-y-2 group-focus-visible:translate-x-2 group-focus-visible:-translate-y-2']}>
          <slot />
        </div>
        <div
          aria-hidden="true"
          class:list={[
            accent,
            'radialBackground absolute top-0 left-0 z-[-1] h-full w-full rounded-3xl border border-carbone transition-all group-hover:-translate-x-2 group-hover:translate-y-2 group-focus-visible:-translate-x-2 group-focus-visible:translate-y-2',
          ]}
        />
      </div>
    </a>
  ) : (
    <div data-card-face class={face}>
      <slot />
    </div>
  )
}
