---
import { normalizePath } from '../lib/path.js'

const { links, classes = '' } = Astro.props
const pathname = normalizePath(Astro.url.pathname)
---

{
  links?.length > 0 && (
    <ul class:list={['flex items-center', classes]}>
      {links.map((link) => {
        const active = pathname === link.href
        return (
          <li>
            <a
              class:list={[
                active ? 'border-corail' : 'border-transparent',
                'border-b-2 font-medium text-white transition-colors hover:border-corail hover:text-corail',
              ]}
              aria-current={active ? 'page' : undefined}
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        )
      })}
    </ul>
  )
}
