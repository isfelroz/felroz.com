---
/** "En ce moment": helicopter drawing and the current role. The employer link is the tile's only link. */
import globalData from '@data/global.json'
import Helicopter from './Helicopter.astro'

const { title, role, newTab } = Astro.props
const { employer } = globalData
---

<div class="flex h-full flex-col gap-2.5">
  <h2 id="now-title" class="text-2xl font-bold tracking-[-0.02em]">{title}</h2>
  <Helicopter class="mx-auto block h-auto max-h-40 min-h-0 w-full max-w-40 shrink grow" />
  <p class="text-xl leading-[1.18] font-bold tracking-[-0.025em]">
    {role}{' '}
    <a
      href={employer.href}
      target="_blank"
      rel="noopener"
      class="border-b-2 border-corail whitespace-nowrap transition-colors hover:border-peche hover:text-peche"
      >{employer.name}<span class="sr-only"> {newTab}</span><svg
        class="ml-[.2em] inline size-[.6em] align-[.15em] text-corail"
        viewBox="0 0 16 16"
        aria-hidden="true"
        ><path
          d="M5 3h8v8M13 3 4 12"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      ></a
    >
  </p>
</div>
