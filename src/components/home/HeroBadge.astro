---
/**
 * Hero badge (spec §4.3): a lanyard slot, a Deep photo panel with the 3D Memoji, then the greeting and the lead.
 * The h1 reads the final greeting; the visible words cycle once (aria-hidden) and rest on the page language's word.
 * The lead's last part carries the home's one signal.
 */
import Avatar3D from './Avatar3D.astro'

interface Props {
  greetings: string[]
  name: string
  lead: string
  signal: string
  avatarAlt: string
}

const { greetings, name, lead, signal, avatarAlt } = Astro.props
const last = greetings.length - 1
---

<div class="hero-badge relative flex h-full flex-col gap-[18px]">
  <span class="hero-slot" aria-hidden="true"></span>

  <div class="hero-stage" data-stage>
    <span class="absolute top-4 right-4 size-3.5 rounded-full bg-peche" aria-hidden="true"></span>
    <Avatar3D alt={avatarAlt} />
  </div>

  <div class="flex flex-col gap-2.5 max-[1100px]:gap-4">
    <h1
      id="hero-title"
      class="text-[clamp(2.5rem,4.6vw,4.5rem)] leading-[1.02] font-bold tracking-[-0.035em] min-[1101px]:text-[clamp(2.4rem,3.4vw,3.4rem)]"
    >
      <span class="sr-only">{greetings[last]} {name}</span>
      <span aria-hidden="true"
        ><span class="hero-greet" data-greet
          >{greetings.map((word, k) => <span class:list={{ on: k === last }}>{word}</span>)}</span
        ><br />{name}</span
      >
    </h1>
    <p
      class="max-w-[30ch] text-[clamp(1.25rem,1.9vw,1.6rem)] leading-[1.2] font-bold tracking-[-0.025em] min-[1101px]:max-w-none min-[1101px]:text-xl"
    >
      {lead}<span class="text-signal">{signal}</span>
    </p>
  </div>
</div>

<script is:inline>
  // Greeting: plays once from the first word and rests on the last; static under reduced motion
  ;(() => {
    const words = document.querySelectorAll('[data-greet] > span')
    if (words.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return
    words.forEach((w, k) => w.classList.toggle('on', k === 0))
    for (let k = 1; k < words.length; k++)
      setTimeout(() => {
        words[k - 1].classList.replace('on', 'out')
        words[k].classList.add('on')
      }, k * 1300)
  })()
</script>

<style is:global>
  /* Global (no scope attributes) so the lead's markup stays plain; every selector is hero-prefixed */
  .hero-slot {
    position: absolute;
    top: -19px; /* 9px from the card edge, through the p-7 padding */
    left: 50%;
    width: 52px;
    height: 6px;
    border-radius: 3px;
    translate: -50% 0;
    background: var(--color-carbone-deep);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.6);
  }
  @media (max-width: 640px) {
    .hero-slot {
      top: -15px; /* p-6 padding */
    }
  }

  .hero-stage {
    position: relative;
    display: grid;
    place-items: center;
    flex: 1;
    min-height: 0;
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
    background-color: var(--color-carbone-deep);
    background-image: radial-gradient(color-mix(in srgb, var(--color-dot) 70%, transparent) 1.2px, transparent 1.4px);
    background-size: 14px 14px;
  }
  @media (max-width: 1100px) {
    .hero-stage {
      flex: none;
      aspect-ratio: 4 / 3;
      margin-bottom: 8px;
    }
  }

  .hero-greet {
    display: inline-grid;
    vertical-align: bottom;
    overflow: hidden;
    height: 1.08em;
  }
  .hero-greet > span {
    grid-area: 1 / 1;
    translate: 0 110%;
    opacity: 0;
    transition:
      translate 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s;
  }
  .hero-greet > .on {
    translate: none;
    opacity: 1;
  }
  .hero-greet > .out {
    translate: 0 -110%;
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-greet > span {
      transition: none;
    }
  }
</style>
