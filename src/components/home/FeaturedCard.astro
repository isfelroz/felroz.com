---
/** "Projet phare": this site, shown as its symbol and brand swatches on a Deep panel. */
import globalData from '@data/global.json'
import Symbol from '@components/brand/Symbol.astro'
import Icon from '@components/react/Icon.jsx'

const { title, text } = Astro.props
const swatches = ['bg-prune', 'bg-corail', 'bg-peche', 'bg-carbone-raised']
---

<div class="featured grid h-full grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-6 max-[640px]:grid-cols-1">
  <div class="grid place-content-center justify-items-center gap-4 rounded-2xl bg-carbone-deep p-5" aria-hidden="true">
    <Symbol size={96} />
    <div class="flex gap-2">{swatches.map((c) => <i class:list={['size-5 rounded-full', c]} />)}</div>
  </div>
  <div class="flex flex-col justify-end gap-2.5">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-2xl font-bold tracking-[-0.02em]">{title}</h2>
      <span class="shrink-0"><Icon type="arrow" /></span>
    </div>
    <p class="text-ink-soft text-pretty">{text}</p>
    <ul class="flex flex-wrap gap-2">
      {
        globalData.featuredTags.map((tag) => (
          <li class="label-mono rounded-full border border-dot px-2.5 py-0.5 text-ink-soft">{tag}</li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .featured :global(.felroz-node) {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.tile:hover) .featured :global(.felroz-node),
  :global(.tile:focus-within) .featured :global(.felroz-node) {
    transform: translate(2px, -2px);
  }
  :global(.tile:hover) .featured :global(.felroz-dot),
  :global(.tile:focus-within) .featured :global(.felroz-dot) {
    transform: translate(4px, -4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .featured :global(.felroz-node) {
      transition: none;
    }
  }
</style>
