---
/** "Parcours": a single-colour mini route (Corail path and nodes, Pêche arrival dot) and the three roles. */
import Icon from '@components/react/Icon.jsx'

const { title, roles, text } = Astro.props
---

<div class="journey flex h-full flex-col justify-end gap-2.5">
  <svg class="h-auto min-h-0 w-full shrink overflow-visible" viewBox="0 0 240 64" aria-hidden="true">
    <path
      d="M16 52 C 50 52, 76 40, 112 40 S 180 30, 222 20"
      fill="none"
      stroke="#CA6678"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray="1 9"></path>
    <circle cx="16" cy="52" r="7" fill="#26282C" stroke="#CA6678" stroke-width="3"></circle>
    <circle cx="112" cy="40" r="6" fill="#26282C" stroke="#CA6678" stroke-width="3"></circle>
    <circle class="arrival" cx="222" cy="20" r="9" fill="#E98A77"></circle>
  </svg>
  <p class="flex justify-between gap-1.5 text-[.8125rem] whitespace-nowrap text-label-dark">
    {roles.map((r) => <span>{r}</span>)}
  </p>
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-2xl font-bold tracking-[-0.02em]">{title}</h2>
    <span class="shrink-0"><Icon type="arrow" /></span>
  </div>
  <p class="text-ink-soft text-pretty">{text}</p>
</div>

<style>
  .arrival {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.tile:hover) .arrival,
  :global(.tile:focus-within) .arrival {
    transform: translate(4px, -4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .arrival {
      transition: none;
    }
  }
</style>
