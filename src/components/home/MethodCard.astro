---
/** "Comment je travaille" tile: a miniature U line (hollow Prune node, Pêche arrival dot) on a Deep panel, then the title and one line. */
import Icon from '@components/react/Icon.jsx'

const { title, text, stations } = Astro.props
// Station order follows the U: top left, top right, bottom right, bottom left
const spots = [
  { x: 28, y: 30, labelY: 14 },
  { x: 132, y: 30, labelY: 14 },
  { x: 132, y: 86, labelY: 108 },
  { x: 28, y: 86, labelY: 108 },
]
---

<div class="method grid h-full grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-6 max-[640px]:grid-cols-1">
  <div class="grid place-content-center rounded-2xl bg-carbone-deep p-5" aria-hidden="true">
    <svg viewBox="0 0 160 116" width="200" class="h-auto w-full max-w-50" fill="none">
      <path
        d="M28 30 H132 V86 H28"
        stroke="#CA6678"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-dasharray="1 8"></path>
      <circle class="method-node" cx="28" cy="30" r="7" fill="#1F2124" stroke="#9E4B88" stroke-width="3.5"></circle>
      <circle cx="132" cy="30" r="5" fill="#1F2124" stroke="#CA6678" stroke-width="2.5"></circle>
      <circle cx="132" cy="86" r="5" fill="#1F2124" stroke="#CA6678" stroke-width="2.5"></circle>
      <circle class="method-dot" cx="28" cy="86" r="9" fill="#E98A77"></circle>
      {
        stations.map((label, i) => (
          <text
            x={spots[i].x}
            y={spots[i].labelY}
            text-anchor="middle"
            fill="#9A9CA3"
            font-family="'DM Mono', monospace"
            font-size="10"
          >
            {label}
          </text>
        ))
      }
    </svg>
  </div>
  <div class="flex flex-col justify-end gap-2.5">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-2xl font-bold tracking-[-0.02em]">{title}</h2>
      <span class="shrink-0"><Icon type="arrow" /></span>
    </div>
    <p class="text-ink-soft text-pretty">{text}</p>
  </div>
</div>

<style>
  .method-node,
  .method-dot {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.tile:hover) .method .method-dot,
  :global(.tile:focus-within) .method .method-dot {
    transform: translate(3px, -3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .method-node,
    .method-dot {
      transition: none;
    }
  }
</style>
