---
/** "Savoir-faire": six neutral line glyphs with their labels (2 × 3), then the toolbelt in the machine voice. */
import globalData from '@data/global.json'
import Icon from '@components/react/Icon.jsx'

const { title, items } = Astro.props
---

<div class="flex h-full flex-col gap-2.5">
  <h2 id="skills-title" class="text-2xl font-bold tracking-[-0.02em]">{title}</h2>
  <ul class="grid grow grid-cols-2 content-center gap-x-5 gap-y-2 max-[480px]:grid-cols-1">
    {
      items.map((item) => (
        <li class="group/skill flex min-w-0 items-center gap-3">
          <span class="grid size-8 shrink-0 place-items-center rounded-xl border border-dot bg-carbone-raised text-ink-soft transition-colors group-hover/skill:border-corail group-hover/skill:text-corail motion-reduce:transition-none">
            <Icon type={item.icon} size="16px" />
          </span>
          <span class="font-bold">{item.label}</span>
        </li>
      ))
    }
  </ul>
  <p class="label-mono text-label-dark">{globalData.toolbelt.join(' · ')}</p>
</div>
