---
import ProgressCircle from '@components/react/ProgressCircle.jsx'

const { percents, size } = Astro.props
---

<div class="relative w-full h-full">
  <ProgressCircle client:visible percents={percents} size={size} />
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
    <slot />
  </div>
</div>
