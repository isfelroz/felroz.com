---
import globalData from '@data/global.json'
import Layout from '@layouts/Layout.astro'
import Bento from '@components/home/Bento.astro'
import Tile from '@components/home/Tile.astro'
import NowCard from '@components/home/NowCard.astro'
import JourneyCard from '@components/home/JourneyCard.astro'
import FeaturedCard from '@components/home/FeaturedCard.astro'
import MeCard from '@components/home/MeCard.astro'
import ContactBand from '@components/home/ContactBand.astro'
import Icon from '@components/react/Icon.jsx'
import { localizePath, useTranslations } from '../i18n/index.js'

const { locale } = Astro.props
const t = useTranslations(locale)
const home = t.home
const stackLabel = home.stack.label.replace('{list}', globalData.stack.map((s) => s.name).join(', '))
---

<Layout locale={locale} routeKey="home">
  <Bento>
    {/* Hero: placeholder until the badge lands (Task 5) */}
    <Tile size="2x2" area="hero" index={0} labelledby="hero-title">
      <h1 id="hero-title" class="text-4xl font-bold tracking-[-0.035em]">{home.hero.name}</h1>
    </Tile>

    <Tile size="1x1" area="now" index={1} labelledby="now-title">
      <NowCard {...home.now} />
    </Tile>

    <Tile size="1x1" area="journey" index={2} href={localizePath('resume', locale)} label={home.journey.title}>
      <JourneyCard {...home.journey} />
    </Tile>

    {/* Savoir-faire: placeholder until Task 4 */}
    <Tile size="2x1" area="skills" index={3} labelledby="skills-title">
      <h2 id="skills-title" class="text-2xl font-bold tracking-[-0.02em]">{home.skills.title}</h2>
    </Tile>

    <Tile size="2x1" area="featured" index={4} href={localizePath('projects', locale)} label={home.featured.title}>
      <FeaturedCard {...home.featured} />
    </Tile>

    {/* Stack: placeholder constellation until Task 4 */}
    <Tile size="1x1" area="stack" index={5} href={localizePath('about', locale)} label={stackLabel}>
      <div class="flex h-full items-end justify-between gap-4">
        <h2 class="text-2xl font-bold tracking-[-0.02em]">{home.stack.title}</h2>
        <span class="shrink-0"><Icon type="arrow" /></span>
      </div>
    </Tile>

    <Tile size="1x1" area="me" index={6} href={localizePath('about', locale)} label={home.me.title}>
      <MeCard {...home.me} />
    </Tile>

    <Tile size="band" area="contact" index={7} labelledby="contact-title">
      <ContactBand title={home.contact.title} socialLabel={home.socialLabel} />
    </Tile>
  </Bento>
</Layout>
