---
import '../styles/global.css'
import globalData from '@data/global.json'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import Container from '@components/Container.astro'

const { title = 'falroz | portfolio' } = Astro.props
const { navigation, socials } = globalData
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      ;(function (w, d, s, l, i) {
        w[l] = w[l] || []
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : ''
        j.async = true
        j.src = 'https://gtm.felroz.com/gtm.js?id=' + i + dl
        f.parentNode.insertBefore(j, f)
      })(window, document, 'script', 'dataLayer', 'GTM-KZBN4VFF')
    </script>
  </head>
  <body class="bg-primary-black w-screen font-DMSans overflow-hidden overflow-y-visible min-h-screen flex flex-col">
    <Header menu={navigation.menu} />
    <main class="flex-auto">
      <Container><slot /></Container>
    </main>
    <Footer menu={navigation.menu} socials={socials} />
  </body>
</html>
