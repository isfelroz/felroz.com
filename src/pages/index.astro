---
import homeData from '@data/home.json'
import Layout from '@layouts/Layout.astro'
import Grid from '@components/Grid.astro'
import Card from '@components/Card.astro'
import ProgressSkill from '@components/ProgressSkill.astro'
import AboutCard from '@components/cards/AboutCard.astro'
import BasicCard from '@components/cards/BasicCard.astro'
import IconCard from '@components/cards/IconCard.astro'
import ContactCard from '@components/cards/ContactCard.astro'
import GridItem from '@components/react/GridItem.jsx'
import Icon from '@components/react/Icon.jsx'
import SocialIcon from '@components/react/SocialIcon.jsx'

const { content } = homeData

const socialColors = {
  twitter: 'bg-twitter',
  linkedin: 'bg-linkedin',
  npm: 'bg-npm',
  github: 'bg-github',
}
---

<Layout>
  <Grid>
    <GridItem client:load size="medium">
      <Card link={{ href: '/about' }} background="bg-[#CA6678]">
        <AboutCard {...content.about} />
      </Card>
    </GridItem>
    <GridItem client:load>
      <Card link={{ href: '/about' }} background="bg-primary">
        <BasicCard />
      </Card>
    </GridItem>
    <GridItem client:load>
      <div class="grid grid-cols-2 grid-rows-2 h-full gap-5 lg:gap-8">
        {
          content.socials.map(({ type, href }) => (
            <Card link={{ href }} background={socialColors[type] ?? 'bg-primary'}>
              <IconCard>
                <SocialIcon type={type} size="80px" />
              </IconCard>
            </Card>
          ))
        }
      </div>
    </GridItem>
    <GridItem client:load>
      <Card link={{ href: '/about' }} background="bg-primary">
        <BasicCard />
      </Card>
    </GridItem>
    <GridItem client:load>
      <Card link={{ href: '/about' }} background="bg-primary">
        <BasicCard />
      </Card>
    </GridItem>
    <GridItem client:load size="medium">
      <Card />
    </GridItem>
    <GridItem client:load>
      <Card link={{ href: '/about' }} background="bg-javascript">
        <BasicCard>
          <ProgressSkill percents={90} size={170}>
            <Icon type="javascript" size="70px" />
          </ProgressSkill>
        </BasicCard>
      </Card>
    </GridItem>
    <GridItem client:load>
      <div class="grid grid-cols-2 grid-rows-2 h-full gap-5 lg:gap-8">
        {
          content.skills.map(({ type, value }) => (
            <div class="relative">
              <Card>
                <div class="absolute top-0 left-0 w-full h-full">
                  <ProgressSkill percents={value} size={100}>
                    <Icon type={type} size="45px" />
                  </ProgressSkill>
                </div>
              </Card>
            </div>
          ))
        }
      </div>
    </GridItem>
    <GridItem client:load size="medium">
      <Card link={{ href: '/about' }} background="bg-primary">
        <ContactCard />
      </Card>
    </GridItem>
  </Grid>
</Layout>
