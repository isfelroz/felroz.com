  "narrative": {
    "northStar": "The Agent Control Room",
    "overview": "felroz is a network of agents seen from a control room at night. The dot grid is the infrastructure, every node is an agent, and the Prune → Corail → Pêche gradient is the signal travelling between them toward an arrival point. Nothing moves unsupervised: routes are deliberate, the signal is rare, and the room stays dark and calm so the signal reads instantly.",
    "keyCharacteristics": [
      "Dark Carbone ground, white text, warm gradient used as a single signal.",
      "Symbol: a gradient f followed by a hollow node and a Pêche arrival dot.",
      "Motifs: dot grid plus dotted routes linking nodes, always in the background.",
      "Cards with soft shadows and an offset hover that reveals a colored dot-grid layer.",
      "DM Sans for everything human; DM Mono in spaced uppercase for everything machine."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "The gradient (left → right: Prune, Corail, Pêche) appears once per screen: on the symbol, one keyword, or one accent such as the primary button. If two things on a screen are gradient, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Plain Text Rule",
        "body": "Running text is white on Carbone or Carbone on Craie. Never gradient, never Corail.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "DM Sans and DM Mono only. No display or decorative faces.",
        "section": "typography"
      },
      {
        "name": "The Machine Voice Rule",
        "body": "DM Mono is always uppercase with 2px tracking, and only for labels, code and metadata. Never for sentences.",
        "section": "typography"
      },
      {
        "name": "The Split Card Rule",
        "body": "Linked cards keep the offset hover: face translate(8px, -8px), underlayer translate(-8px, 8px), both with transition-all. Do not flatten it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the gradient to one signal per screen (the One Signal Rule).",
      "Do set running text white on Carbone, or Carbone on Craie.",
      "Do use DM Mono, uppercase with 2px tracking, for labels, metadata and code.",
      "Do keep the card shadow and the split offset hover on every linked card.",
      "Do use the symbol from 24px up and the lone Corail f below 24px.",
      "Do size UI to the longer French copy."
    ],
    "donts": [
      "Don't draw the f with a crossbar. The decided mark has none.",
      "Don't use the retired falroz wordmark or name.",
      "Don't place routes or dotted lines behind text, or use dashed lines anywhere outside the route motif.",
      "Don't add a second type family (Aclonica is retired).",
      "Don't set body copy, paragraphs or long labels in gradient.",
      "Don't use the third-party brand colors outside their own cards.",
      "Don't replace the 3D card treatment with flat cards."
    ]
  }
